{
  "name": "@tillflow/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node --import ./src/register.js --import ./src/telemetry.js src/server.js",
    "dev": "node --watch --import ./src/register.js --import ./src/telemetry.js src/server.js",
    "test": "node --test",
    "lint": "eslint .",
    "coverage": "c8 --check-coverage --lines 70 --reporter=text --reporter=lcov node --test"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/id-generator-aws-xray": "^2.1.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/propagator-aws-xray": "^2.2.0",
    "@opentelemetry/sdk-node": "^0.222.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "c8": "^10.1.3",
    "eslint": "^9.39.0",
    "globals": "^15.15.0"
  }
}
