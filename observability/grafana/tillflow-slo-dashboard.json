{
  "__inputs": [
    {
      "name": "DS_CLOUDWATCH",
      "label": "CloudWatch",
      "description": "CloudWatch datasource for the TillFlow account, region us-east-2.",
      "type": "datasource",
      "pluginId": "cloudwatch",
      "pluginName": "CloudWatch"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    },
    {
      "type": "datasource",
      "id": "cloudwatch",
      "name": "CloudWatch",
      "version": "1.0.0"
    }
  ],
  "title": "TillFlow \u2014 SLO & service health",
  "uid": "tillflow-slo",
  "description": "Reliability + operations dashboard. Panel order follows the question order of an incident: is it up, how much budget is left, how fast is it burning, then RED, saturation, and finally whether the product is actually working. Owned by @mercykilonzo; see docs/runbook.md.",
  "tags": [
    "tillflow",
    "slo",
    "devops-g2"
  ],
  "timezone": "Africa/Nairobi",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "cloudwatch",
        "current": {
          "text": "CloudWatch",
          "value": "${DS_CLOUDWATCH}"
        },
        "hide": 0
      },
      {
        "name": "region",
        "type": "constant",
        "query": "us-east-2",
        "current": {
          "text": "us-east-2",
          "value": "us-east-2"
        },
        "hide": 2
      },
      {
        "name": "pos_tg",
        "label": "POS target group",
        "type": "query",
        "datasource": {
          "type": "cloudwatch",
          "uid": "${DS_CLOUDWATCH}"
        },
        "query": {
          "queryType": "dimensionValues",
          "region": "$region",
          "namespace": "AWS/ApplicationELB",
          "metricName": "RequestCount",
          "dimensionKey": "TargetGroup",
          "dimensionFilters": {}
        },
        "regex": "/.*pos-tg.*/",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "hide": 0
      },
      {
        "name": "payments_tg",
        "label": "Payments target group",
        "type": "query",
        "datasource": {
          "type": "cloudwatch",
          "uid": "${DS_CLOUDWATCH}"
        },
        "query": {
          "queryType": "dimensionValues",
          "region": "$region",
          "namespace": "AWS/ApplicationELB",
          "metricName": "RequestCount",
          "dimensionKey": "TargetGroup",
          "dimensionFilters": {}
        },
        "regex": "/.*payments-tg.*/",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "hide": 0
      },
      {
        "name": "alb",
        "label": "Load balancer",
        "type": "query",
        "datasource": {
          "type": "cloudwatch",
          "uid": "${DS_CLOUDWATCH}"
        },
        "query": {
          "queryType": "dimensionValues",
          "region": "$region",
          "namespace": "AWS/ApplicationELB",
          "metricName": "RequestCount",
          "dimensionKey": "LoadBalancer",
          "dimensionFilters": {}
        },
        "regex": "/^app\\/devops-g2-alb\\/.*/",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "hide": 0
      }
    ]
  },
  "links": [
    {
      "title": "Runbook",
      "type": "link",
      "url": "https://github.com/aine-mbabazi/devops-g2-tillflow/blob/main/docs/runbook.md",
      "targetBlank": true
    },
    {
      "title": "SLOs & error budgets",
      "type": "link",
      "url": "https://github.com/aine-mbabazi/devops-g2-tillflow/blob/main/docs/slo-error-budgets.md",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Uptime & budget",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Uptime \u2014 5 minutes",
      "description": "External synthetic probe success rate over the last 5 minutes. This is the 'is it up right now' number.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CLOUDWATCH}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 3,
          "min": 95,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 99.5
              },
              {
                "color": "green",
                "value": 99.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "namespace": "TillFlow/synthetics",
          "metricName": "SuccessPercent",
          "dimensions": {
            "ProbeName": "devops-g2-probe"
          },
          "statistic": "Average",
          "period": "300",
          "region": "$region",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "matchExact": true,
          "id": ""
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Uptime \u2014 1 hour",
      "description": "Same probe, one-hour window. Smooths a single failed run so a transient blip does not read as an outage.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CLOUDWATCH}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 99.5
              },
              {
                "color": "green",
                "value": 99.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "namespace": "TillFlow/synthetics",
          "metricName": "SuccessPercent",
          "dimensions": {
            "ProbeName": "devops-g2-probe"
          },
          "statistic": "Average",
          "period": "3600",
          "region": "$region",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "matchExact": true,
          "id": ""
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Uptime \u2014 28 days",
      "description": "The SLO window itself. This is the number the reliability contract in docs/slo-error-budgets.md is actually written against \u2014 the two above are for triage, this one is for the commitment.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CLOUDWATCH}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 99.5
              },
              {
                "color": "green",
                "value": 99.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "mean"
          ]
        },
        "text": {}
      },
      "timeFrom": "28d",
      "targets": [
        {
          "refId": "A",
          "namespace": "TillFlow/synthetics",
          "metricName": "SuccessPercent",
          "dimensions": {
            "ProbeName": "devops-g2-probe"
          },
          "statistic": "Average",
          "period": "3600",
          "region": "$region",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "matchExact": true,
          "id": ""
        }
      ]
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "POS error budget remaining (28d)",
      "description": "100 \u00d7 (1 \u2212 consumed \u00f7 allowed), where allowed = 0.1% of eligible requests over 28 days (40m 19s). Below 0 the budget is overspent and the release freeze in docs/slo-error-budgets.md applies.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CLOUDWATCH}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 25
              },
              {
                "color": "green",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "timeFrom": "28d",
      "targets": [
        {
          "refId": "A",
          "namespace": "AWS/ApplicationELB",
          "metricName": "HTTPCode_Target_5XX_Count",
          "dimensions": {
            "TargetGroup": "$pos_tg",
            "LoadBalancer": "$alb"
          },
          "statistic": "Sum",
          "period": "3600",
          "region": "$region",
          "hide": true,
          "id": "errors",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "matchExact": true
        },
        {
          "refId": "B",
          "namespace": "AWS/ApplicationELB",
          "metricName": "RequestCount",
          "dimensions": {
            "TargetGroup": "$pos_tg",
            "LoadBalancer": "$alb"
          },
          "statistic": "Sum",
          "period": "3600",
          "region": "$region",
          "hide": true,
          "id": "requests",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "matchExact": true
        },
        {
          "refId": "C",
          "expression": "100 * (1 - (SUM(FILL(errors,0)) / IF(SUM(requests) > 0, SUM(requests), 1)) / 0.001)",
          "id": "budget",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "region": "$region",
          "queryMode": "Metrics",
          "matchExact": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "POS burn rate (\u00d7 sustainable)",
      "description": "1.0 means the 28-day budget is consumed in exactly 28 days. The two threshold lines are the same values the devops-g2-pos-budget-fast-burn and -slow-burn alarms use, so this panel and the page can never disagree.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CLOUDWATCH}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "namespace": "AWS/ApplicationELB",
          "metricName": "HTTPCode_Target_5XX_Count",
          "dimensions": {
            "TargetGroup": "$pos_tg",
            "LoadBalancer": "$alb"
          },
          "statistic": "Sum",
          "period": "3600",
          "region": "$region",
          "hide": true,
          "id": "errors",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "matchExact": true
        },
        {
          "refId": "B",
          "namespace": "AWS/ApplicationELB",
          "metricName": "RequestCount",
          "dimensions": {
            "TargetGroup": "$pos_tg",
            "LoadBalancer": "$alb"
          },
          "statistic": "Sum",
          "period": "3600",
          "region": "$region",
          "hide": true,
          "id": "requests",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "matchExact": true
        },
        {
          "refId": "C",
          "expression": "(FILL(errors,0) / IF(requests > 0, requests, 1)) / 0.001",
          "id": "burn",
          "label": "burn rate",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "region": "$region",
          "queryMode": "Metrics",
          "matchExact": true
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Payments callback lag p95 vs the 60s SLI",
      "description": "Derived from the callback_processed log event via the devops-g2-callback-lag metric filter. Above the line, sales sit pending at the till after the customer has already paid.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CLOUDWATCH}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 60000
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "namespace": "TillFlow/payments",
          "metricName": "CallbackLagMs",
          "statistic": "p95",
          "period": "300",
          "region": "$region",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "matchExact": true,
          "id": ""
        }
      ]
    },
    {
      "type": "row",
      "title": "RED \u2014 rate, errors, duration",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "collapsed": false
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Rate \u2014 requests/min",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CLOUDWATCH}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "namespace": "AWS/ApplicationELB",
          "metricName": "RequestCount",
          "dimensions": {
            "TargetGroup": "$pos_tg",
            "LoadBalancer": "$alb"
          },
          "statistic": "Sum",
          "period": "60",
          "label": "POS",
          "region": "$region",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "matchExact": true,
          "id": ""
        },
        {
          "refId": "B",
          "namespace": "AWS/ApplicationELB",
          "metricName": "RequestCount",
          "dimensions": {
            "TargetGroup": "$payments_tg",
            "LoadBalancer": "$alb"
          },
          "statistic": "Sum",
          "period": "60",
          "label": "Payments",
          "region": "$region",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "matchExact": true,
          "id": ""
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Errors \u2014 5xx/min",
      "description": "Target 5xx is the service failing. ELB 5xx with no target 5xx means the load balancer had no healthy target to send to \u2014 a different incident with a different first action.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CLOUDWATCH}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "namespace": "AWS/ApplicationELB",
          "metricName": "HTTPCode_Target_5XX_Count",
          "dimensions": {
            "TargetGroup": "$pos_tg",
            "LoadBalancer": "$alb"
          },
          "statistic": "Sum",
          "period": "60",
          "label": "POS 5xx",
          "region": "$region",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "matchExact": true,
          "id": ""
        },
        {
          "refId": "B",
          "namespace": "AWS/ApplicationELB",
          "metricName": "HTTPCode_Target_5XX_Count",
          "dimensions": {
            "TargetGroup": "$payments_tg",
            "LoadBalancer": "$alb"
          },
          "statistic": "Sum",
          "period": "60",
          "label": "Payments 5xx",
          "region": "$region",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "matchExact": true,
          "id": ""
        },
        {
          "refId": "C",
          "namespace": "AWS/ApplicationELB",
          "metricName": "HTTPCode_ELB_5XX_Count",
          "dimensions": {
            "LoadBalancer": "$alb"
          },
          "statistic": "Sum",
          "period": "60",
          "label": "ALB 5xx (no healthy target)",
          "region": "$region",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "matchExact": true,
          "id": ""
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Duration \u2014 p95 latency",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CLOUDWATCH}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.4
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "namespace": "AWS/ApplicationELB",
          "metricName": "TargetResponseTime",
          "dimensions": {
            "TargetGroup": "$pos_tg",
            "LoadBalancer": "$alb"
          },
          "statistic": "p95",
          "period": "60",
          "label": "POS p95 (SLO 400ms)",
          "region": "$region",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "matchExact": true,
          "id": ""
        },
        {
          "refId": "B",
          "namespace": "AWS/ApplicationELB",
          "metricName": "TargetResponseTime",
          "dimensions": {
            "TargetGroup": "$payments_tg",
            "LoadBalancer": "$alb"
          },
          "statistic": "p95",
          "period": "60",
          "label": "Payments p95",
          "region": "$region",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "matchExact": true,
          "id": ""
        }
      ]
    },
    {
      "type": "row",
      "title": "Saturation",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "collapsed": false
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "ECS task CPU / memory",
      "description": "Threshold lines are the k6 capacity envelope (CPU < 70%, memory < 75%), so the live dashboard is judged against the same ceiling the capacity model was measured against.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CLOUDWATCH}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 75
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "namespace": "AWS/ECS",
          "metricName": "CPUUtilization",
          "dimensions": {
            "ClusterName": "devops-g2",
            "ServiceName": "devops-g2-pos"
          },
          "statistic": "Average",
          "period": "60",
          "label": "POS CPU",
          "region": "$region",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "matchExact": true,
          "id": ""
        },
        {
          "refId": "B",
          "namespace": "AWS/ECS",
          "metricName": "MemoryUtilization",
          "dimensions": {
            "ClusterName": "devops-g2",
            "ServiceName": "devops-g2-pos"
          },
          "statistic": "Average",
          "period": "60",
          "label": "POS memory",
          "region": "$region",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "matchExact": true,
          "id": ""
        },
        {
          "refId": "C",
          "namespace": "AWS/ECS",
          "metricName": "CPUUtilization",
          "dimensions": {
