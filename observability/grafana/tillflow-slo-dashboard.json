{
  "__inputs": [
    {
      "name": "DS_CLOUDWATCH",
      "label": "CloudWatch",
      "description": "CloudWatch datasource for the TillFlow account, region us-east-2.",
      "type": "datasource",
      "pluginId": "cloudwatch",
      "pluginName": "CloudWatch"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.0.0" },
    { "type": "datasource", "id": "cloudwatch", "name": "CloudWatch", "version": "1.0.0" }
  ],
  "title": "TillFlow — SLO & service health",
  "uid": "tillflow-slo",
  "description": "Reliability + operations dashboard. Panel order follows the question order of an incident: is it up, how much budget is left, how fast is it burning, then RED, saturation, and finally whether the product is actually working. Owned by @mercykilonzo; see docs/runbook.md.",
  "tags": ["tillflow", "slo", "devops-g2"],
  "timezone": "Africa/Nairobi",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "cloudwatch",
        "current": { "text": "CloudWatch", "value": "${DS_CLOUDWATCH}" },
        "hide": 0
      },
      {
        "name": "region",
        "type": "constant",
        "query": "us-east-2",
        "current": { "text": "us-east-2", "value": "us-east-2" },
        "hide": 2
      }
    ]
  },
  "links": [
    {
      "title": "Runbook",
      "type": "link",
      "url": "https://github.com/aine-mbabazi/devops-g2-tillflow/blob/main/docs/runbook.md",
      "targetBlank": true
    },
    {
      "title": "SLOs & error budgets",
      "type": "link",
      "url": "https://github.com/aine-mbabazi/devops-g2-tillflow/blob/main/docs/slo-error-budgets.md",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Uptime & budget",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Uptime — 5 minutes",
      "description": "External synthetic probe success rate over the last 5 minutes. This is the 'is it up right now' number.",
      "datasource": { "type": "cloudwatch", "uid": "${DS_CLOUDWATCH}" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 3,
          "min": 95,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 99.5 },
              { "color": "green", "value": 99.9 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "graphMode": "none", "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "namespace": "CloudWatchSynthetics",
          "metricName": "SuccessPercent",
          "dimensions": { "CanaryName": "devops-g2-probe" },
          "statistic": "Average",
          "period": "300",
          "region": "$region"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Uptime — 1 hour",
      "description": "Same probe, one-hour window. Smooths a single failed run so a transient blip does not read as an outage.",
      "datasource": { "type": "cloudwatch", "uid": "${DS_CLOUDWATCH}" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 99.5 },
              { "color": "green", "value": 99.9 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "graphMode": "none", "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "namespace": "CloudWatchSynthetics",
          "metricName": "SuccessPercent",
          "dimensions": { "CanaryName": "devops-g2-probe" },
          "statistic": "Average",
          "period": "3600",
          "region": "$region"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Uptime — 28 days",
      "description": "The SLO window itself. This is the number the reliability contract in docs/slo-error-budgets.md is actually written against — the two above are for triage, this one is for the commitment.",
      "datasource": { "type": "cloudwatch", "uid": "${DS_CLOUDWATCH}" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 99.5 },
              { "color": "green", "value": 99.9 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "reduceOptions": { "calcs": ["mean"] },
        "text": {}
      },
      "timeFrom": "28d",
      "targets": [
        {
          "refId": "A",
          "namespace": "CloudWatchSynthetics",
          "metricName": "SuccessPercent",
          "dimensions": { "CanaryName": "devops-g2-probe" },
          "statistic": "Average",
          "period": "3600",
          "region": "$region"
        }
      ]
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "POS error budget remaining (28d)",
      "description": "100 × (1 − consumed ÷ allowed), where allowed = 0.1% of eligible requests over 28 days (40m 19s). Below 0 the budget is overspent and the release freeze in docs/slo-error-budgets.md applies.",
      "datasource": { "type": "cloudwatch", "uid": "${DS_CLOUDWATCH}" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 25 },
              { "color": "green", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "timeFrom": "28d",
      "targets": [
        {
          "refId": "errors",
          "namespace": "AWS/ApplicationELB",
          "metricName": "HTTPCode_Target_5XX_Count",
          "dimensions": { "TargetGroup": "devops-g2-pos-tg" },
          "statistic": "Sum",
          "period": "3600",
          "region": "$region",
          "hide": true
        },
        {
          "refId": "requests",
          "namespace": "AWS/ApplicationELB",
          "metricName": "RequestCount",
          "dimensions": { "TargetGroup": "devops-g2-pos-tg" },
          "statistic": "Sum",
          "period": "3600",
          "region": "$region",
          "hide": true
        },
        {
          "refId": "budget",
          "expression": "100 * (1 - (SUM(FILL(errors,0)) / IF(SUM(requests) > 0, SUM(requests), 1)) / 0.001)",
          "id": "budget",
          "metricQueryType": 1,
          "metricEditorMode": 1,
          "region": "$region"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "POS burn rate (× sustainable)",
      "description": "1.0 means the 28-day budget is consumed in exactly 28 days. The two threshold lines are the same values the devops-g2-pos-budget-fast-burn and -slow-burn alarms use, so this panel and the page can never disagree.",
      "datasource": { "type": "cloudwatch", "uid": "${DS_CLOUDWATCH}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 6 },
              { "color": "red", "value": 14.4 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "errors",
          "namespace": "AWS/ApplicationELB",
          "metricName": "HTTPCode_Target_5XX_Count",
          "dimensions": { "TargetGroup": "devops-g2-pos-tg" },
          "statistic": "Sum",
          "period": "3600",
          "region": "$region",
          "hide": true
        },
        {
          "refId": "requests",
          "namespace": "AWS/ApplicationELB",
          "metricName": "RequestCount",
          "dimensions": { "TargetGroup": "devops-g2-pos-tg" },
          "statistic": "Sum",
          "period": "3600",
          "region": "$region",
          "hide": true
        },
        {
          "refId": "burn",
          "expression": "(FILL(errors,0) / IF(requests > 0, requests, 1)) / 0.001",
          "id": "burn",
          "label": "burn rate",
          "metricQueryType": 1,
          "metricEditorMode": 1,
          "region": "$region"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Payments callback lag p95 vs the 60s SLI",
      "description": "Derived from the callback_processed log event via the devops-g2-callback-lag metric filter. Above the line, sales sit pending at the till after the customer has already paid.",
      "datasource": { "type": "cloudwatch", "uid": "${DS_CLOUDWATCH}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 60000 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "namespace": "TillFlow/payments",
          "metricName": "CallbackLagMs",
          "statistic": "p95",
          "period": "300",
          "region": "$region"
        }
      ]
    },
    {
      "type": "row",
      "title": "RED — rate, errors, duration",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "collapsed": false
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Rate — requests/min",
      "datasource": { "type": "cloudwatch", "uid": "${DS_CLOUDWATCH}" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "reqpm", "custom": { "drawStyle": "line", "lineWidth": 2 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "namespace": "AWS/ApplicationELB",
          "metricName": "RequestCount",
          "dimensions": { "TargetGroup": "devops-g2-pos-tg" },
          "statistic": "Sum",
          "period": "60",
          "label": "POS",
          "region": "$region"
        },
        {
          "refId": "B",
          "namespace": "AWS/ApplicationELB",
          "metricName": "RequestCount",
          "dimensions": { "TargetGroup": "devops-g2-payments-tg" },
          "statistic": "Sum",
          "period": "60",
          "label": "Payments",
          "region": "$region"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Errors — 5xx/min",
      "description": "Target 5xx is the service failing. ELB 5xx with no target 5xx means the load balancer had no healthy target to send to — a different incident with a different first action.",
      "datasource": { "type": "cloudwatch", "uid": "${DS_CLOUDWATCH}" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "namespace": "AWS/ApplicationELB",
          "metricName": "HTTPCode_Target_5XX_Count",
          "dimensions": { "TargetGroup": "devops-g2-pos-tg" },
          "statistic": "Sum",
          "period": "60",
          "label": "POS 5xx",
          "region": "$region"
        },
        {
          "refId": "B",
          "namespace": "AWS/ApplicationELB",
          "metricName": "HTTPCode_Target_5XX_Count",
          "dimensions": { "TargetGroup": "devops-g2-payments-tg" },
          "statistic": "Sum",
          "period": "60",
          "label": "Payments 5xx",
          "region": "$region"
        },
        {
          "refId": "C",
          "namespace": "AWS/ApplicationELB",
          "metricName": "HTTPCode_ELB_5XX_Count",
          "dimensions": { "LoadBalancer": "devops-g2-alb" },
          "statistic": "Sum",
          "period": "60",
          "label": "ALB 5xx (no healthy target)",
          "region": "$region"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Duration — p95 latency",
      "datasource": { "type": "cloudwatch", "uid": "${DS_CLOUDWATCH}" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.4 },
              { "color": "red", "value": 0.5 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "namespace": "AWS/ApplicationELB",
          "metricName": "TargetResponseTime",
          "dimensions": { "TargetGroup": "devops-g2-pos-tg" },
          "statistic": "p95",
          "period": "60",
          "label": "POS p95 (SLO 400ms)",
          "region": "$region"
        },
        {
          "refId": "B",
          "namespace": "AWS/ApplicationELB",
          "metricName": "TargetResponseTime",
          "dimensions": { "TargetGroup": "devops-g2-payments-tg" },
          "statistic": "p95",
          "period": "60",
          "label": "Payments p95",
          "region": "$region"
        }
      ]
    },
    {
      "type": "row",
      "title": "Saturation",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 },
      "collapsed": false
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "ECS task CPU / memory",
      "description": "Threshold lines are the k6 capacity envelope (CPU < 70%, memory < 75%), so the live dashboard is judged against the same ceiling the capacity model was measured against.",
      "datasource": { "type": "cloudwatch", "uid": "${DS_CLOUDWATCH}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 22 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "drawStyle": "line", "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 70 },
              { "color": "red", "value": 75 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "namespace": "AWS/ECS",
          "metricName": "CPUUtilization",
          "dimensions": { "ClusterName": "devops-g2", "ServiceName": "devops-g2-pos" },
          "statistic": "Average",
          "period": "60",
          "label": "POS CPU",
          "region": "$region"
        },
        {
          "refId": "B",
          "namespace": "AWS/ECS",
          "metricName": "MemoryUtilization",
          "dimensions": { "ClusterName": "devops-g2", "ServiceName": "devops-g2-pos" },
          "statistic": "Average",
          "period": "60",
          "label": "POS memory",
          "region": "$region"
        },
        {
          "refId": "C",
          "namespace": "AWS/ECS",
          "metricName": "CPUUtilization",
          "dimensions": { "ClusterName": "devops-g2", "ServiceName": "devops-g2-payments" },
          "statistic": "Average",
          "period": "60",
          "label": "Payments CPU",
          "region": "$region"
        },
        {
          "refId": "D",
          "namespace": "AWS/ECS",
          "metricName": "MemoryUtilization",
          "dimensions": { "ClusterName": "devops-g2", "ServiceName": "devops-g2-payments" },
          "statistic": "Average",
          "period": "60",
          "label": "Payments memory",
          "region": "$region"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "RDS — CPU and connections",
      "description": "One db.t4g.micro is shared by POS, Payments and Commission. It is the first place to look when two services degrade at once.",
      "datasource": { "type": "cloudwatch", "uid": "${DS_CLOUDWATCH}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 22 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "namespace": "AWS/RDS",
          "metricName": "CPUUtilization",
          "dimensions": { "DBInstanceIdentifier": "devops-g2-db" },
          "statistic": "Average",
          "period": "60",
          "label": "CPU %",
          "region": "$region"
        },
        {
          "refId": "B",
          "namespace": "AWS/RDS",
          "metricName": "DatabaseConnections",
          "dimensions": { "DBInstanceIdentifier": "devops-g2-db" },
          "statistic": "Maximum",
          "period": "60",
          "label": "connections",
          "region": "$region"
        }
      ]
    },
    {
      "type": "row",
      "title": "Business signals & money-correctness",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 29 },
      "collapsed": false
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Sales recorded vs payments dispatched",
      "description": "These two lines should track each other. A sustained gap means sales are being recorded that never reach Payments — a product failure every panel above reports as healthy.",
      "datasource": { "type": "cloudwatch", "uid": "${DS_CLOUDWATCH}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 30 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 2 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "namespace": "TillFlow/business",
          "metricName": "SalesRecorded",
          "statistic": "Sum",
          "period": "300",
          "label": "sales recorded",
          "region": "$region"
        },
        {
          "refId": "B",
          "namespace": "TillFlow/business",
          "metricName": "PaymentsDispatched",
          "statistic": "Sum",
          "period": "300",
          "label": "payments dispatched",
          "region": "$region"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Money-correctness invariants — any non-zero value is an incident",
      "description": "Callback conflicts, reconcile mismatches and failed daily closes. None of these produce a 5xx, so none of them appear anywhere else on this dashboard.",
      "datasource": { "type": "cloudwatch", "uid": "${DS_CLOUDWATCH}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 30 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "drawStyle": "bars", "fillOpacity": 70 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "namespace": "TillFlow/integrity",
          "metricName": "CallbackConflicts",
          "statistic": "Sum",
          "period": "300",
          "label": "callback conflicts",
          "region": "$region"
        },
        {
          "refId": "B",
          "namespace": "TillFlow/integrity",
          "metricName": "ReconcileMismatches",
          "statistic": "Sum",
          "period": "300",
          "label": "reconcile mismatches",
          "region": "$region"
        },
        {
          "refId": "C",
          "namespace": "TillFlow/commission",
          "metricName": "DailyCloseFailures",
          "statistic": "Sum",
          "period": "300",
          "label": "daily close failures",
          "region": "$region"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Commission payouts per daily close",
      "description": "Counts attendants actually disbursed, not runs executed — one close covers every attendant in a tenant.",
      "datasource": { "type": "cloudwatch", "uid": "${DS_CLOUDWATCH}" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 37 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "namespace": "TillFlow/business",
          "metricName": "CommissionPayouts",
          "statistic": "Sum",
          "period": "86400",
          "label": "payouts disbursed",
          "region": "$region"
        }
      ]
    }
  ]
}
